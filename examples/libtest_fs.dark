extract fs

ok = write_text("/tmp/darktest.txt", "hello dark\n")
emit("write=" + to_string(ok) + "\n")
t = read_text("/tmp/darktest.txt")
emit("read=" + t)
ls1 = ls("/tmp")
emit("ls=" + to_string(size(ls1)) + "\n")
fsz = fsize("/tmp/darktest.txt")
emit("fsize=" + to_string(fsz) + "\n")
isf = is_file("/tmp/darktest.txt")
emit("is_file=" + to_string(isf) + "\n")
isd = is_dir("/tmp")
emit("is_dir=" + to_string(isd) + "\n")
cp = copy("/tmp/darktest.txt", "/tmp/darktest2.txt")
emit("copy=" + to_string(cp) + "\n")
mv = move("/tmp/darktest2.txt", "/tmp/darktest3.txt")
emit("move=" + to_string(mv) + "\n")
ap = append_text("/tmp/darktest.txt", "more\n")
emit("append=" + to_string(ap) + "\n")
ln = read_lines("/tmp/darktest.txt")
emit("lines=" + to_string(size(ln)) + "\n")
wl = write_lines("/tmp/darktest4.txt", ["x", "y"])
emit("wlines=" + to_string(wl) + "\n")
mkd = mk("/tmp/darksub")
emit("mkdir=" + to_string(mkd) + "\n")
r1 = rm("/tmp/darktest.txt")
emit("rm=" + to_string(r1) + "\n")