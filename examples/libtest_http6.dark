extract http

p = post_headers("https://postman-echo.com/post", "a=1&b=2", {"Content-Type": "application/x-www-form-urlencoded", "X-Test": "hello"})
emit("code=" + to_string(p["code"]) + "\n")
emit("len=" + to_string(size(p["body"])) + "\n")
emit("has_header=" + to_string(contains(p["body"], "X-Test")) + "\n")
