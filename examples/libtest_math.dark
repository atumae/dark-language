extract math

g = gcd(12, 18)
emit("gcd=" + to_string(g) + "\n")
l = lcm(4, 6)
emit("lcm=" + to_string(l) + "\n")
cl = clamp(15, 0, 10)
emit("clamp=" + to_string(cl) + "\n")
d = count_divisors(12)
emit("divisors=" + to_string(d) + "\n")
f = fact(5)
emit("fact=" + to_string(f) + "\n")
fi = fibonacci(10)
emit("fib=" + to_string(fi) + "\n")
sq = is_perfect_square(81)
emit("sq=" + to_string(sq) + "\n")
pr = is_prime(97)
emit("prime=" + to_string(pr) + "\n")
me = mean([1, 2, 3, 4])
emit("mean=" + to_string(me) + "\n")
md = median([1, 3, 2])
emit("median=" + to_string(md) + "\n")
sg = sign(-7)
emit("sign=" + to_string(sg) + "\n")
so = sort([3, 1, 2])
emit("sort=" + to_string(so[0]) + "," + to_string(so[1]) + "," + to_string(so[2]) + "\n")
si = sqrt_int(64)
emit("sqrt=" + to_string(si) + "\n")