extract json

js = json_stringify([1, "two", 3])
emit("stringify=" + js + "\n")
o = json_parse("{\"a\":1,\"b\":[true,null]}")
emit("parse=" + to_string(size(keys(o))) + "\n")
v = json_val(o, "a")
emit("val=" + to_string(v) + "\n")
q = json_quote("hi\"there")
emit("quote=" + q + "\n")
e = json_enc(5)
emit("enc=" + e + "\n")
n = json_num(42)
emit("num=" + n + "\n")
s = json_str("abc")
emit("str=" + s + "\n")
a = json_arr([1, 2])
emit("arr=" + a + "\n")
j = json_obj([["x", 1]])
emit("obj=" + j + "\n")
sw = json_skip_ws("  abc", 0)
emit("skip_ws=" + to_string(sw) + "\n")
je = json_enc_arr([1, 2])
emit("enc_arr=" + je + "\n")
jop = json_enc_obj([["x", 1]])
emit("enc_obj=" + jop + "\n")