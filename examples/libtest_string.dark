extract string

c = capitalize("hello")
emit("cap=" + c + "\n")
ct = contains("hello", "ell")
emit("contains=" + to_string(ct) + "\n")
n = count("banana", "a")
emit("count=" + to_string(n) + "\n")
ew = ends_with("hello", "lo")
emit("ends=" + to_string(ew) + "\n")
ewn = ends_with_num("file42", 42)
emit("ends_num=" + to_string(ewn) + "\n")
iof = index_of("hello", "l")
emit("idx=" + to_string(iof) + "\n")
bl = is_blank("   ")
emit("blank=" + to_string(bl) + "\n")
em = is_empty("")
emit("empty=" + to_string(em) + "\n")
pal = is_palindrome("radar")
emit("pal=" + to_string(pal) + "\n")
sp = is_space(" ")
emit("space=" + to_string(sp) + "\n")
j = join(["a", "b"], "-")
emit("join=" + j + "\n")
liof = last_index_of("hello", "l")
emit("last_idx=" + to_string(liof) + "\n")
lo = lower("HELLO")
emit("lower=" + lo + "\n")
pl = pad_left("5", 3, "0")
emit("pad_l=" + pl + "\n")
pr = pad_right("5", 3, "0")
emit("pad_r=" + pr + "\n")
rp = repeat_str("ab", 3)
emit("repeat=" + rp + "\n")
re = replace("hello", "l", "x")
emit("replace=" + re + "\n")
rea = replace_all("hello", "l", "x")
emit("replace_all=" + rea + "\n")
rs = reverse_str("abc")
emit("reverse=" + rs + "\n")
sp2 = split("a,b,c", ",")
emit("split=" + to_string(size(sp2)) + "\n")
sc = split_chars("abc")
emit("chars=" + to_string(size(sc)) + "\n")
sl = split_lines("a\nb")
emit("lines=" + to_string(size(sl)) + "\n")
sw2 = split_words("hello world test")
emit("words=" + to_string(size(sw2)) + "\n")
swf = starts_with("hello", "he")
emit("starts=" + to_string(swf) + "\n")
swfn = starts_with_num("abc123", 123)
emit("starts_num=" + to_string(swfn) + "\n")
ti = title("hello world")
emit("title=" + ti + "\n")
tr = trim("  x  ")
emit("trim=" + tr + "\n")
trl = trim_left("  x")
emit("trim_l=" + trl + "\n")
trr = trim_right("x  ")
emit("trim_r=" + trr + "\n")
up = upper("hello")
emit("upper=" + up + "\n")