extract random

r = rand()
emit("rand=" + to_string(r) + "\n")
i = rand_int(1, 100)
emit("rand_int=" + to_string(i) + "\n")
b = rand_bool()
emit("rand_bool=" + to_string(b) + "\n")
c = chance(50)
emit("chance=" + to_string(c) + "\n")
p = pick([10, 20, 30])
emit("pick=" + to_string(p) + "\n")
s = shuffle([1, 2, 3, 4, 5])
emit("shuffle_size=" + to_string(size(s)) + "\n")
fl = random_float()
emit("random_float=" + to_string(fl) + "\n")