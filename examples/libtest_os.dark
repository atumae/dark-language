extract os

cwd1 = cwd()
emit("cwd=" + cwd1 + "\n")
on = os_name()
emit("os=" + on + "\n")
hn = hostname()
emit("host=" + hn + "\n")
av = argv()
emit("argc=" + to_string(size(av)) + "\n")
ge = getenv("HOME")
emit("home=" + ge + "\n")
cc = cpu_count()
emit("cpu=" + to_string(cc) + "\n")
mt = memory_total()
emit("mem=" + to_string(mt) + "\n")
on2 = uname()
emit("uname=" + on2 + "\n")
setenv("FOO", "bar")
g = getenv("FOO")
emit("getenv_after=" + g + "\n")