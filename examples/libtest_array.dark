extract array

r = range(1, 5)
emit("range=" + to_string(size(r)) + "\n")
s = sum(r)
emit("sum=" + to_string(s) + "\n")
p = product(r)
emit("product=" + to_string(p) + "\n")
m = min(r)
emit("min=" + to_string(m) + "\n")
x = max(r)
emit("max=" + to_string(x) + "\n")
t = take(r, 3)
emit("take=" + to_string(size(t)) + "\n")
d = drop(r, 2)
emit("drop=" + to_string(size(d)) + "\n")
z = zip(r, r)
emit("zip=" + to_string(size(z)) + "\n")
c = chunk(r, 2)
emit("chunk=" + to_string(size(c)) + "\n")
u = unique([1, 1, 2, 3, 3])
emit("unique=" + to_string(size(u)) + "\n")
idx = index_of_arr(r, 3)
emit("idx=" + to_string(idx) + "\n")
has = arr_contains(r, 4)
emit("has4=" + to_string(has) + "\n")
f = flatten([[1, 2], [3]])
emit("flatten=" + to_string(size(f)) + "\n")
j = join_all(["a", "b", "c"], "-")
emit("join=" + j + "\n")
rs = range_step(0, 10, 2)
emit("range_step=" + to_string(size(rs)) + "\n")
red = reduce(r, 0, 0)
emit("reduce=" + to_string(red) + "\n")