extract http

fn main() {
    url = "https://moscow.megafon.ru/api/mlk/sim-cards/iccInit"
    body = "{\"iccid\": \"12345678901234567890\"}"
    r = post(url, body)
    emit("Status: " + to_string(r["code"]) + "\n")
    emit("body_len: " + to_string(size(r["body"])) + "\n")
    emit("Response: " + r["body"] + "\n")
}
main()
