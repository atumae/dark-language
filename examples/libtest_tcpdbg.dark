extract fs
extract net

ip = dns("moscow.megafon.ru")
write_text("dbg1.txt", "ip=" + to_string(ip) + "\n")

s = tcp_connect(ip, 443)
write_text("dbg2.txt", "connected=" + to_string(s) + "\n")

tcp_send(s, "hello")
write_text("dbg3.txt", "sent\n")

r = tcp_recv(s, 1024)
write_text("dbg4.txt", "recv_len=" + to_string(size(r)) + "\n")

tcp_close(s)
write_text("dbg5.txt", "closed\n")
