extract json
extract string

data = {"name": "Dark", "version": 1, "features": ["self-hosting", "modules", "pe"], "site": "github.com/atumae"}
emit(json_stringify(data))

parsed = json_parse("{\"x\": 10, \"y\": [1, 2, 3], \"name\": \"hi\"}")
emit("x = " + to_string(parsed["x"]))
emit("y = " + join(parsed["y"], ","))
emit("name = " + parsed["name"])

nested = json_parse("[{\"a\": 1}, {\"a\": 2}, {\"a\": 3}]")
sum = 0
for (o of nested) {
    sum = sum + o["a"]
}
emit("sum of a = " + to_string(sum))
