// Megafon number collector — Dark-порт Python-скрипта.
//
// Нереализованное (в Dark нет):
//  1. HTTPS/TLS — net.http_raw это сырой TCP без TLS. Реальный endpoint
//     https://...megafon.ru недостижим, нужен TLS. Порт 443 только для верности.
//  2. Потоки (ThreadPoolExecutor) — нет, цикл последовательный.

extract json
extract string
extract net
extract map

REGION = "moscow"
OUTPUT_FILE = "numbers.txt"
THREADS = 5
TOTAL_REQUESTS = 50
FILTER = "3554"

USER_AGENT = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36"

COOKIE = "_ym_uid=1781198434884389032; _ym_d=1781198434; isEmployee=0; tmr_lvid=f7fd95d3d4ed3f8650d24d72b28d0bf5; tmr_lvidTS=1781198436307; mid=a494b4e8-7fb3-4700-9431-569675365815; reg=" + REGION + "; branchName=" + REGION + "; branchId=3"

fn load_existing() {
    set = {}
    if (exists(OUTPUT_FILE)) {
        lines = split(slurp(OUTPUT_FILE), "\n")
        i = 0
        while (i < size(lines)) {
            l = trim(lines[i])
            if (l != "") {
                set[l] = 1
            }
            i = i + 1
        }
    }
    give set
}

fn save_numbers(new_numbers) {
    existing = load_existing()
    added = 0
    out = ""
    i = 0
    while (i < size(new_numbers)) {
        n = new_numbers[i]
        if (existing[n] == null) {
            existing[n] = 1
            out = out + n + "\n"
            added = added + 1
        }
        i = i + 1
    }
    if (added > 0) {
        old = ""
        if (exists(OUTPUT_FILE)) {
            old = slurp(OUTPUT_FILE)
        }
        spit(OUTPUT_FILE, old + out)
        emit("[+] added " + to_string(added) + " new numbers\n")
    }
    give added
}

fn fetch_numbers(id) {
    sleep(random() % 1500 + 500)

    path = "/api/mlk/sim-cards/dsim/numbers?numberClass=simple"
    if (FILTER != "") {
        path = path + "&filterType=FAVORITE_NUMBER&filter=" + FILTER
    }

    req = "GET " + path + " HTTP/1.1\r\n"
    req = req + "Host: " + REGION + ".megafon.ru\r\n"
    req = req + "User-Agent: " + USER_AGENT + "\r\n"
    req = req + "Accept: application/json, text/plain, */*\r\n"
    req = req + "Referer: https://" + REGION + ".megafon.ru/sim/dynamic/\r\n"
    req = req + "Cookie: " + COOKIE + "\r\n"
    req = req + "Connection: close\r\n\r\n"

    raw = http_raw(REGION + ".megafon.ru", 443, req)

    code = 0
    sp = index_of(raw, " ")
    if (sp != 0 - 1 && size(raw) > sp + 4) {
        code = to_int(substring(raw, sp + 1, sp + 4))
    }

    if (code == 200) {
        body = raw
        p = index_of(raw, "\r\n\r\n")
        if (p != 0 - 1) {
            body = substring(raw, p + 4)
        }
        if (size(body) > 0 && (starts_with(body, "{") || starts_with(body, "["))) {
            data = json_parse(body)
            numbers = get_or(data, "numbers", [])
            emit("[" + to_string(id) + "] ok: " + to_string(size(numbers)) + " numbers\n")
            give numbers
        }
    }
    emit("[" + to_string(id) + "] error " + to_string(code) + "\n")
    give []
}

existing = load_existing()
emit("start: " + to_string(TOTAL_REQUESTS) + " requests, region " + REGION + "\n")
emit("already have: " + to_string(size_map(existing)) + " numbers\n")

total_added = 0
i = 0
while (i < TOTAL_REQUESTS) {
    numbers = fetch_numbers(i)
    total_added = total_added + save_numbers(numbers)
    i = i + 1
}

emit("done. added: " + to_string(total_added) + "\n")
final = load_existing()
emit("total in file: " + to_string(size_map(final)) + " numbers\n")
exit_code(0)
