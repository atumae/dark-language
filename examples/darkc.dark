extract parser
extract codegen

a = args()
src_path = ""
out_path = ""
target = ""
verbose = 0
run_mode = 1
i = 1
while (i < size(a)) {
    arg = a[i]
    if (arg == "-o") {
        i = i + 1
        if (i < size(a)) {
            out_path = a[i]
            run_mode = 0
        }
    } else {
        if (arg == "--target") {
            i = i + 1
            if (i < size(a)) {
                target = a[i]
                run_mode = 0
            }
        } else {
            if (arg == "-v" || arg == "--verbose") {
                verbose = 1
            } else {
                if (arg == "--run") {
                    run_mode = 1
                } else {
                    if (char_at(arg, 0) == "-") {
                        emit("error: unknown flag " + arg)
                        exit_code(2)
                    } else {
                        if (src_path == "") {
                            src_path = arg
                        } else {
                            if (out_path == "") {
                                out_path = arg
                                run_mode = 0
                            }
                        }
                    }
                }
            }
        }
    }
    i = i + 1
}
if (src_path == "") {
    emit("usage: darkc <src.dark> [-o <out>] [--target linux|windows] [--run]")
    exit_code(2)
}

src = slurp(src_path)
if (size(src) == 0) {
    emit("error: cannot read " + src_path)
    exit_code(1)
}
toks = tokenize(src)
ast = parse_program(toks)
if (verbose == 1) {
    emit("parsed " + to_string(size(ast)) + " top-level statements")
}
result = null
if (target == "") {
    result = compile_auto(ast)
} else {
    result = compile_target(ast, target)
}
if (result[0] == "error") {
    errs = result[1]
    j = 0
    while (j < size(errs)) {
        emit("error: " + errs[j])
        j = j + 1
    }
    exit_code(1)
}
if (run_mode == 1) {
    run_path = "/tmp/darkc_run_" + to_string(random())
    make_exe(run_path, result[1])
    exec(run_path)
}
make_exe(out_path, result[1])
emit("compiled " + src_path + " -> " + out_path)
