
fn gcd(a, b) {
    while (b != 0) {
        t = a % b
        a = b
        b = t
    }
    give a
}

fn lcm(a, b) {
    if (a == 0 && b == 0) { give 0 }
    give a / gcd(a, b) * b
}

fn is_prime(n) {
    if (n < 2) { give 0 }
    if (n == 2) { give 1 }
    if (n % 2 == 0) { give 0 }
    i = 3
    while (i * i <= n) {
        if (n % i == 0) { give 0 }
        i = i + 2
    }
    give 1
}

fn fibonacci(n) {
    if (n <= 1) { give n }
    a = 0
    b = 1
    i = 2
    while (i <= n) {
        c = a + b
        a = b
        b = c
        i = i + 1
    }
    give b
}

fn sum(arr) {
    s = 0
    i = 0
    while (i < size(arr)) {
        s = s + arr[i]
        i = i + 1
    }
    give s
}

fn product(arr) {
    p = 1
    i = 0
    while (i < size(arr)) {
        p = p * arr[i]
        i = i + 1
    }
    give p
}

fn mean(arr) {
    if (size(arr) == 0) { give 0 }
    give sum(arr) / size(arr)
}

fn sort(arr) {
    r = []
    i = 0
    while (i < size(arr)) {
        v = arr[i]
        j = size(r)
        while (j > 0 && r[j - 1] > v) {
            j = j - 1
        }
        r2 = []
        k = 0
        while (k < j) {
            r2 = push(r2, r[k])
            k = k + 1
        }
        r2 = push(r2, v)
        while (k < size(r)) {
            r2 = push(r2, r[k])
            k = k + 1
        }
        r = r2
        i = i + 1
    }
    give r
}

fn median(arr) {
    n = size(arr)
    if (n == 0) { give 0 }
    s = sort(arr)
    if (n % 2 == 1) { give s[n / 2] }
    give (s[n / 2 - 1] + s[n / 2]) / 2
}

fn clamp(n, lo, hi) {
    if (n < lo) { give lo }
    if (n > hi) { give hi }
    give n
}

fn sign(n) {
    if (n > 0) { give 1 }
    if (n < 0) { give 0 - 1 }
    give 0
}

fn sqrt_int(n) {
    if (n < 0) { give 0 }
    if (n < 2) { give n }
    x = n
    y = (x + n / x) / 2
    while (y < x) {
        x = y
        y = (x + n / x) / 2
    }
    give x
}

fn fact(n) {
    r = 1
    i = 1
    while (i <= n) {
        r = r * i
        i = i + 1
    }
    give r
}

fn is_perfect_square(n) {
    if (n < 0) { give 0 }
    s = sqrt_int(n)
    give s * s == n
}

fn count_divisors(n) {
    c = 0
    i = 1
    while (i <= n) {
        if (n % i == 0) { c = c + 1 }
        i = i + 1
    }
    give c
}
