fn rand() {
    give random()
}

fn rand_int(a, b) {
    give random_range(a, b)
}

fn random_range(a, b) {
    if (b <= a) { give a }
    give a + random() % (b - a)
}

fn rand_bool() {
    give random() % 2
}

fn chance(p) {
    give random() % 100 < p
}

fn pick(arr) {
    if (size(arr) == 0) { give null }
    give arr[random_range(0, size(arr))]
}

fn shuffle(arr) {
    r = arr
    i = size(r) - 1
    while (i > 0) {
        j = random_range(0, i + 1)
        t = r[i]
        r[i] = r[j]
        r[j] = t
        i = i - 1
    }
    give r
}

fn random_float() {
    give random() % 1000000
}
