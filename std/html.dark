fn escape(s) {
    r = ""
    i = 0
    while (i < size(s)) {
        c = char_at(s, i)
        if (c == "&") {
            r = r + "&amp;"
        } else {
            if (c == "<") {
                r = r + "&lt;"
            } else {
                if (c == ">") {
                    r = r + "&gt;"
                } else {
                    if (c == "\"") {
                        r = r + "&quot;"
                    } else {
                        if (c == "'") {
                            r = r + "&#39;"
                        } else {
                            r = r + c
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    give r
}

fn page(title, body) {
    give "<!DOCTYPE html><html><head><meta charset='utf-8'><title>" + escape(title) + "</title></head><body>" + body + "</body></html>"
}

fn h1(s) {
    give "<h1>" + escape(s) + "</h1>"
}

fn h2(s) {
    give "<h2>" + escape(s) + "</h2>"
}

fn p(s) {
    give "<p>" + escape(s) + "</p>"
}

fn a(href, text) {
    give "<a href=\"" + escape(href) + "\">" + escape(text) + "</a>"
}

fn ul(items) {
    r = "<ul>"
    i = 0
    while (i < size(items)) {
        r = r + "<li>" + escape(items[i]) + "</li>"
        i = i + 1
    }
    give r + "</ul>"
}

fn style() {
    give "<style>body{font-family:system-ui;max-width:720px;margin:2rem auto;padding:0 1rem;color:#e8e6f5;background:#0d0b1e}a{color:#8be9fd}</style>"
}
