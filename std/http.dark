extract string
extract tls

// Parse "scheme://host[:port][/path]" -> {"scheme","host","port","path"}
fn parse_url(url) {
    r = {"scheme": "http", "host": "", "port": 80, "path": "/"}
    rest = url
    i = index_of(url, "://")
    if (i != 0 - 1) {
        r["scheme"] = substring(url, 0, i)
        rest = substring(url, i + 3, size(url))
    }
    slash = index_of(rest, "/")
    hostpart = rest
    if (slash != 0 - 1) {
        hostpart = substring(rest, 0, slash)
        r["path"] = substring(rest, slash, size(rest))
    }
    colon = index_of(hostpart, ":")
    if (colon != 0 - 1) {
        r["host"] = substring(hostpart, 0, colon)
        r["port"] = to_int(substring(hostpart, colon + 1, size(hostpart)))
    } else {
        r["host"] = hostpart
    }
    if (r["scheme"] == "https" && r["port"] == 80) {
        r["port"] = 443
    }
    give r
}

// Low-level: send an HTTP/1.1 request over a connected socket, read the full
// response until the connection closes.
fn http_request_raw(u, method, body) {
    req = method + " " + u["path"] + " HTTP/1.1\r\n"
    req = req + "Host: " + u["host"] + "\r\n"
    req = req + "Connection: close\r\n"
    req = req + "Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\n"
    req = req + "Accept-Language: ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7\r\n"
    req = req + "Accept-Encoding: gzip, deflate, br\r\n"
    req = req + "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\r\n"
    req = req + "Connection: close\r\n"
    if (method == "POST") {
        req = req + "Content-Length: " + to_string(size(body)) + "\r\n"
    }
    req = req + "\r\n"
    if (method == "POST") {
        req = req + body
    }
    if (u["scheme"] == "https") {
        raw = https_request(u["host"], u["port"], req)
        give parse_http(raw)
    }
    s = tcp_connect(dns(u["host"]), u["port"])
    if (s < 0) {
        give {"code": 0, "body": "", "headers": {}}
    }
    tcp_send(s, req)
    buf = ""
    while (1) {
        chunk = tcp_recv(s, 4096)
        if (size(chunk) == 0) { break }
        buf = buf + chunk
    }
    tcp_close(s)
    give parse_http(buf)
}

// Parse a raw HTTP response into {"code","body","headers"}
fn dechunk(raw) {
    body = ""
    i = 0
    n = size(raw)
    while (i < n) {
        hex = ""
        while (i < n && char_at(raw, i) != "\r") {
            hex = hex + char_at(raw, i)
            i = i + 1
        }
        i = i + 2
        sz = 0
        j = 0
        while (j < size(hex)) {
            c = ord(char_at(hex, j))
            if (c >= 48 && c <= 57) { c = c - 48 }
            if (c >= 97 && c <= 102) { c = c - 87 }
            if (c >= 65 && c <= 70) { c = c - 55 }
            sz = (sz << 4) | c
            j = j + 1
        }
        if (sz == 0) {
            break
        }
        body = body + substring(raw, i, i + sz)
        i = i + sz + 2
    }
    give body
}

// Parse a raw HTTP response into {"code","body","headers"}
fn parse_http(raw) {
    hd = index_of(raw, "\r\n\r\n")
    if (hd == 0 - 1) {
        give {"code": 0, "body": raw, "headers": {}}
    }
    head = substring(raw, 0, hd)
    body = substring(raw, hd + 4, size(raw))
    lines = split(head, "\r\n")
    code = 0
    if (size(lines) > 0) {
        parts = split(lines[0], " ")
        if (size(parts) > 1) {
            code = to_int(parts[1])
        }
    }
    headers = {}
    i = 1
    while (i < size(lines)) {
        line = lines[i]
        c = index_of(line, ":")
        if (c != 0 - 1) {
            k = trim(substring(line, 0, c))
            v = trim(substring(line, c + 1, size(line)))
            headers[k] = v
        }
        i = i + 1
    }
    if (headers["Transfer-Encoding"] == "chunked" || headers["transfer-encoding"] == "chunked") {
        body = dechunk(body)
    }
    give {"code": code, "body": body, "headers": headers}
}

// Public API
fn get(url) {
    give http_request_raw(parse_url(url), "GET", "")
}

fn post(url, body) {
    give http_request_raw(parse_url(url), "POST", body)
}

fn get_text(url) {
    r = get(url)
    give r["body"]
}

fn post_text(url, body) {
    r = post(url, body)
    give r["body"]
}

fn download(url, path) {
    r = get(url)
    spit(path, r["body"])
    give r["code"]
}

fn status_ok(r) {
    give r["code"] >= 200 && r["code"] < 300
}

fn header(r, name) {
    give r["headers"][name]
}