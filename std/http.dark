fn get_text(url) {
    r = get(url)
    give r.body
}

fn post_text(url, body) {
    r = post(url, body)
    give r.body
}

fn download(url, path) {
    r = get(url)
    spit(path, r.body)
    give r.code
}

fn status_ok(r) {
    give r.code >= 200 && r.code < 300
}

fn headers(r) {
    give r.code
}
