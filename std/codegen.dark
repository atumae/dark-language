extract pe
extract parser
extract crypto_blob

fn str_bytes(s) {
    r = []
    i = 0
    while (i < size(s)) {
        r = push(r, ord(char_at(s, i)))
        i = i + 1
    }
    give r
}

fn patch_bytes(arr, pos, bytes) {
    i = 0
    while (i < size(bytes)) {
        arr[pos + i] = bytes[i]
        i = i + 1
    }
    give arr
}

fn new_ctx() {
    ctx = {}
    ctx["code"] = []
    ctx["vars"] = {}
    ctx["nvar"] = 0
    ctx["strings"] = []
    ctx["fix"] = []
    ctx["jmp"] = []
    ctx["labels"] = zeros(1024)
    ctx["lbl"] = 0
    ctx["fns"] = {}
    ctx["params"] = {}
    ctx["locals"] = {}
    ctx["nlocal"] = 0
    ctx["heap"] = 0
    ctx["errors"] = []
    ctx["for_count"] = 0
    give ctx
}

fn emitc(ctx, bytes) {
    ctx["code"] = join_arrays(ctx["code"], bytes)
    give ctx
}

fn new_label(ctx) {
    l = ctx["lbl"]
    ctx["lbl"] = l + 1
    give l
}

fn set_label(ctx, l) {
    ctx["labels"][l] = size(ctx["code"])
    give ctx
}

fn jmp(ctx, l) {
    emitc(ctx, [233])
    pos = size(ctx["code"])
    ctx["jmp"] = push(ctx["jmp"], [pos, l])
    emitc(ctx, zeros(4))
    give ctx
}

fn jz(ctx, l) {
    emitc(ctx, [15, 132])
    pos = size(ctx["code"])
    ctx["jmp"] = push(ctx["jmp"], [pos, l])
    emitc(ctx, zeros(4))
    give ctx
}

fn jnz(ctx, l) {
    emitc(ctx, [15, 133])
    pos = size(ctx["code"])
    ctx["jmp"] = push(ctx["jmp"], [pos, l])
    emitc(ctx, zeros(4))
    give ctx
}

fn var_slot(ctx, name) {
    if (ctx["vars"][name] == null) {
        ctx["vars"][name] = ctx["nvar"]
        ctx["nvar"] = ctx["nvar"] + 1
    }
    give ctx["vars"][name]
}

fn gen_var_read(ctx, name) {
    if (name == "null") {
        emitc(ctx, [72, 184])
        emitc(ctx, to_le8(1))
        give ctx
    }
    if (ctx["params"][name] != null) {
        off = 16 + 8 * ctx["params"][name]
        emitc(ctx, [72, 139, 133])
        emitc(ctx, to_le4(off))
    } else {
        if (ctx["locals"][name] != null) {
            off = 0 - 8 - 8 * ctx["locals"][name]
            emitc(ctx, [72, 139, 133])
            emitc(ctx, to_le4(off))
        } else {
            slot = var_slot(ctx, name)
            emitc(ctx, [72, 161])
            pos = size(ctx["code"])
            ctx["fix"] = push(ctx["fix"], [pos, "var", slot])
            emitc(ctx, zeros(8))
        }
    }
    give ctx
}

fn gen_var_write(ctx, name) {
    if (ctx["params"][name] != null) {
        off = 16 + 8 * ctx["params"][name]
        emitc(ctx, [72, 137, 133])
        emitc(ctx, to_le4(off))
    } else {
        if (ctx["locals"][name] != null) {
            off = 0 - 8 - 8 * ctx["locals"][name]
            emitc(ctx, [72, 137, 133])
            emitc(ctx, to_le4(off))
        } else {
            slot = var_slot(ctx, name)
            emitc(ctx, [72, 163])
            pos = size(ctx["code"])
            ctx["fix"] = push(ctx["fix"], [pos, "var", slot])
            emitc(ctx, zeros(8))
        }
    }
    give ctx
}

fn gen_call_runtime(ctx, name, nargs) {
    pos = size(ctx["code"]) + 1
    ctx["fix"] = push(ctx["fix"], [pos, "call", name])
    emitc(ctx, [232, 0, 0, 0, 0])
    if (nargs > 0) {
        emitc(ctx, [72, 131, 196])
        emitc(ctx, [nargs * 8])
    }
    give ctx
}

fn gen_win_call(ctx, id) {
    emitc(ctx, [255, 21])
    pos = size(ctx["code"])
    ctx["fix"] = push(ctx["fix"], [pos, "win", id])
    emitc(ctx, zeros(4))
    give ctx
}

fn align_up(n, a) {
    give ((n + a - 1) / a) * a
}

fn gen_expr(ctx, e) {
    k = e[0]
    if (k == "int") {
        emitc(ctx, [72, 184])
        emitc(ctx, to_le8(e[1] * 2))
        give ctx
    }
    if (k == "str") {
        str_id = size(ctx["strings"])
        ctx["strings"] = push(ctx["strings"], e[1])
        emitc(ctx, [72, 184])
        pos = size(ctx["code"])
        ctx["fix"] = push(ctx["fix"], [pos, "str", str_id])
        emitc(ctx, zeros(8))
        emitc(ctx, [72, 131, 200, 1])
        give ctx
    }
    if (k == "var") {
        name = e[1]
        if (ctx["fns"][name] != null && ctx["params"][name] == null && ctx["locals"][name] == null && ctx["vars"][name] == null) {
            emitc(ctx, [72, 184])
            pos = size(ctx["code"])
            ctx["fix"] = push(ctx["fix"], [pos, "func", name])
            emitc(ctx, zeros(8))
            emitc(ctx, [72, 131, 200, 1])
            give ctx
        }
        gen_var_read(ctx, name)
        give ctx
    }
    if (k == "call") {
        name = e[1]
        args = e[2]
        if (ctx["params"][name] != null || ctx["locals"][name] != null || ctx["vars"][name] != null) {
            i = size(args) - 1
            while (i >= 0) {
                gen_expr(ctx, args[i])
                emitc(ctx, [80])
                i = i - 1
            }
            gen_var_read(ctx, name)
            emitc(ctx, [72, 131, 232, 1])
            emitc(ctx, [72, 139, 64, 8])
            emitc(ctx, [255, 208])
            n = size(args)
            if (n > 0) {
                emitc(ctx, [72, 131, 196])
                emitc(ctx, [n * 8])
            }
            give ctx
        }
        i = size(args) - 1
        while (i >= 0) {
            gen_expr(ctx, args[i])
            emitc(ctx, [80])
            i = i - 1
        }
        gen_call_runtime(ctx, name, size(args))
        give ctx
    }
    if (k == "binop") {
        op = e[2]
        if (op == "+") {
            gen_expr(ctx, e[3])
            emitc(ctx, [80])
            gen_expr(ctx, e[1])
            emitc(ctx, [80])
            gen_call_runtime(ctx, "__add", 2)
            give ctx
        }
        gen_expr(ctx, e[1])
        emitc(ctx, [80])
        gen_expr(ctx, e[3])
        emitc(ctx, [91])
        if (op == "-") { emitc(ctx, [72, 147, 72, 41, 216]) }
        if (op == "*") { emitc(ctx, [72, 15, 175, 195, 72, 209, 248]) }
        if (op == "/") { emitc(ctx, [72, 147, 72, 153, 72, 247, 251, 72, 209, 224]) }
        if (op == "%") { emitc(ctx, [72, 147, 72, 153, 72, 247, 251, 72, 137, 208]) }
        if (op == "&") { emitc(ctx, [72, 33, 216]) }
        if (op == "|") { emitc(ctx, [72, 9, 216]) }
        if (op == "^") { emitc(ctx, [72, 49, 216]) }
        if (op == "<<") { emitc(ctx, [72, 209, 248, 72, 137, 193, 72, 209, 251, 72, 211, 227, 72, 137, 216, 72, 209, 224]) }
        if (op == ">>") { emitc(ctx, [72, 209, 248, 72, 137, 193, 72, 209, 251, 72, 211, 251, 72, 137, 216, 72, 209, 224]) }
        give ctx
    }
    if (k == "cmp") {
        gen_expr(ctx, e[3])
        emitc(ctx, [80])
        gen_expr(ctx, e[1])
        emitc(ctx, [80])
        gen_call_runtime(ctx, "__cmp", 2)
        op = e[2]
        cc = 148
        if (op == "==") { cc = 148 }
        if (op == "!=") { cc = 149 }
        if (op == ">") { cc = 159 }
        if (op == "<") { cc = 156 }
        if (op == ">=") { cc = 157 }
        if (op == "<=") { cc = 158 }
        emitc(ctx, [72, 131, 248, 0])
        emitc(ctx, [15, cc, 192])
        emitc(ctx, [72, 15, 182, 192, 72, 209, 224])
        give ctx
    }
    if (k == "arr") {
        n = size(e[1])
        emitc(ctx, [72, 184])
        emitc(ctx, to_le8(n * 2))
        emitc(ctx, [80])
        gen_call_runtime(ctx, "__make_array", 1)
        emitc(ctx, [80])
        i = 0
        while (i < n) {
            gen_expr(ctx, e[1][i])
            emitc(ctx, [72, 139, 28, 36])
            emitc(ctx, [72, 131, 235, 1])
            emitc(ctx, [72, 137, 131])
            emitc(ctx, to_le4(24 + i * 8))
            i = i + 1
        }
        emitc(ctx, [72, 139, 4, 36])
        emitc(ctx, [72, 131, 196, 8])
        give ctx
    }
    if (k == "index") {
        gen_expr(ctx, e[2])
        emitc(ctx, [80])
        gen_expr(ctx, e[1])
        emitc(ctx, [80])
        gen_call_runtime(ctx, "__get", 2)
        give ctx
    }
    if (k == "dict") {
        gen_call_runtime(ctx, "__obj_new", 0)
        emitc(ctx, [80])
        i = 0
        n = size(e[1])
        while (i < n) {
            pair = e[1][i]
            gen_expr(ctx, pair[1])
            emitc(ctx, [80])
            gen_expr(ctx, pair[0])
            emitc(ctx, [80])
            emitc(ctx, [72, 139, 68, 36, 16])
            emitc(ctx, [80])
            gen_call_runtime(ctx, "__set", 3)
            i = i + 1
        }
        emitc(ctx, [88])
        give ctx
    }
    emitc(ctx, [72, 184])
    emitc(ctx, to_le8(1))
    give ctx
}

fn gen_stmts(ctx, stmts) {
    i = 0
    while (i < size(stmts)) {
        gen_stmt(ctx, stmts[i])
        i = i + 1
    }
    give ctx
}

fn gen_stmt(ctx, s) {
    k = s[0]
    if (k == "set") {
        gen_expr(ctx, s[2])
        gen_var_write(ctx, s[1])
        give ctx
    }
    if (k == "set_index") {
        gen_expr(ctx, s[3])
        emitc(ctx, [80])
        gen_expr(ctx, s[2])
        emitc(ctx, [80])
        gen_expr(ctx, s[1])
        emitc(ctx, [80])
        gen_call_runtime(ctx, "__set", 3)
        give ctx
    }
    if (k == "expr_stmt") {
        gen_expr(ctx, s[1])
        give ctx
    }
    if (k == "ret") {
        gen_expr(ctx, s[1])
        emitc(ctx, [201, 195])
        give ctx
    }
    if (k == "emit") {
        e = s[1]
        if (e[0] == "str") {
            str_id = size(ctx["strings"])
            ctx["strings"] = push(ctx["strings"], e[1])
            if (ctx["target"] == "windows") {
                emitc(ctx, [72, 131, 236, 40])
                emitc(ctx, [72, 199, 193, 245, 255, 255, 255])
                gen_win_call(ctx, 0)
                emitc(ctx, [72, 137, 193])
                emitc(ctx, [72, 186])
                pos = size(ctx["code"])
                ctx["fix"] = push(ctx["fix"], [pos, "str", str_id])
                emitc(ctx, zeros(8))
                emitc(ctx, [72, 131, 194, 16])
                emitc(ctx, [73, 199, 192])
                emitc(ctx, to_le4(size(e[1])))
                emitc(ctx, [73, 185])
                pos = size(ctx["code"])
                ctx["fix"] = push(ctx["fix"], [pos, "written", 0])
                emitc(ctx, zeros(8))
                emitc(ctx, [72, 199, 68, 36, 32, 0, 0, 0, 0])
                gen_win_call(ctx, 1)
                emitc(ctx, [198, 4, 36, 10, 72, 199, 193, 245, 255, 255, 255])
                gen_win_call(ctx, 0)
                emitc(ctx, [72, 137, 193, 72, 137, 226, 73, 199, 192, 1, 0, 0, 0, 73, 185])
                pos = size(ctx["code"])
                ctx["fix"] = push(ctx["fix"], [pos, "written", 0])
                emitc(ctx, zeros(8))
                emitc(ctx, [72, 199, 68, 36, 32, 0, 0, 0, 0])
                gen_win_call(ctx, 1)
                emitc(ctx, [72, 131, 196, 40])
            } else {
                emitc(ctx, [184, 1, 0, 0, 0, 191, 1, 0, 0, 0, 72, 190])
                pos = size(ctx["code"])
                ctx["fix"] = push(ctx["fix"], [pos, "str", str_id])
                emitc(ctx, zeros(8))
                emitc(ctx, [72, 131, 198, 16])
                emitc(ctx, [72, 186])
                emitc(ctx, to_le8(size(e[1])))
                emitc(ctx, [15, 5])
                emitc(ctx, [106, 10])
                emitc(ctx, [72, 137, 230])
                emitc(ctx, [72, 199, 194, 1, 0, 0, 0])
                emitc(ctx, [184, 1, 0, 0, 0])
                emitc(ctx, [191, 1, 0, 0, 0])
                emitc(ctx, [15, 5])
                emitc(ctx, [72, 131, 196, 8])
            }
        } else {
            gen_expr(ctx, e)
            emitc(ctx, [80])
            gen_call_runtime(ctx, "to_string", 1)
            emitc(ctx, [80])
            gen_call_runtime(ctx, "__emit_str", 1)
        }
        give ctx
    }
    if (k == "exit_code") {
        gen_expr(ctx, s[1])
        emitc(ctx, [72, 209, 248])
        if (ctx["target"] == "windows") {
            emitc(ctx, [72, 137, 193])
            gen_win_call(ctx, 2)
        } else {
            emitc(ctx, [72, 137, 199, 184, 60, 0, 0, 0, 15, 5])
        }
        give ctx
    }
    if (k == "if") {
        else_l = new_label(ctx)
        end_l = new_label(ctx)
        gen_expr(ctx, s[1])
        emitc(ctx, [72, 133, 192])
        jz(ctx, else_l)
        gen_stmts(ctx, s[2])
        jmp(ctx, end_l)
        set_label(ctx, else_l)
        if (size(s) > 3) {
            gen_stmts(ctx, s[3])
        }
        set_label(ctx, end_l)
        give ctx
    }
    if (k == "while") {
        start_l = new_label(ctx)
        end_l = new_label(ctx)
        old_s = ctx["loop_s"]
        old_e = ctx["loop_e"]
        ctx["loop_s"] = start_l
        ctx["loop_e"] = end_l
        set_label(ctx, start_l)
        gen_expr(ctx, s[1])
        emitc(ctx, [72, 133, 192])
        jz(ctx, end_l)
        gen_stmts(ctx, s[2])
        jmp(ctx, start_l)
        set_label(ctx, end_l)
        ctx["loop_s"] = old_s
        ctx["loop_e"] = old_e
        give ctx
    }
    if (k == "for") {
        varname = s[1]
        indexvar = s[2]
        c = ctx["for_count"]
        ctx["for_count"] = c + 1
        iter_name = "__it" + to_string(c)
        idx_name = "__ix" + to_string(c)
        gen_expr(ctx, s[3])
        gen_var_write(ctx, iter_name)
        emitc(ctx, [72, 184])
        emitc(ctx, to_le8(0))
        gen_var_write(ctx, idx_name)
        start_l = new_label(ctx)
        end_l = new_label(ctx)
        cont_l = new_label(ctx)
        old_s = ctx["loop_s"]
        old_e = ctx["loop_e"]
        ctx["loop_s"] = cont_l
        ctx["loop_e"] = end_l
        set_label(ctx, start_l)
        cond = ["cmp", ["var", idx_name], "<", ["call", "size", [["var", iter_name]]]]
        gen_expr(ctx, cond)
        emitc(ctx, [72, 133, 192])
        jz(ctx, end_l)
        gen_var_read(ctx, idx_name)
        emitc(ctx, [80])
        gen_var_read(ctx, iter_name)
        emitc(ctx, [80])
        gen_call_runtime(ctx, "__get", 2)
        gen_var_write(ctx, varname)
        if (indexvar != null) {
            gen_var_read(ctx, idx_name)
            gen_var_write(ctx, indexvar)
        }
        gen_stmts(ctx, s[4])
        set_label(ctx, cont_l)
        gen_var_read(ctx, idx_name)
        emitc(ctx, [72, 131, 192, 2])
        gen_var_write(ctx, idx_name)
        jmp(ctx, start_l)
        set_label(ctx, end_l)
        ctx["loop_s"] = old_s
        ctx["loop_e"] = old_e
        give ctx
    }
    if (k == "skip") {
        jmp(ctx, ctx["loop_s"])
        give ctx
    }
    if (k == "break") {
        jmp(ctx, ctx["loop_e"])
        give ctx
    }
    give ctx
}

fn collect_locals(ctx, stmts) {
    i = 0
    while (i < size(stmts)) {
        s = stmts[i]
        k = s[0]
        if (k == "set") {
            name = s[1]
            if (ctx["params"][name] == null && ctx["locals"][name] == null) {
                ctx["locals"][name] = ctx["nlocal"]
                ctx["nlocal"] = ctx["nlocal"] + 1
            }
        }
        if (k == "if") {
            collect_locals(ctx, s[2])
            if (size(s) > 3) {
                collect_locals(ctx, s[3])
            }
        }
        if (k == "while") {
            collect_locals(ctx, s[2])
        }
        if (k == "for") {
            varname = s[1]
            indexvar = s[2]
            c = ctx["for_count"]
            ctx["for_count"] = c + 1
            iter_name = "__it" + to_string(c)
            idx_name = "__ix" + to_string(c)
            if (ctx["params"][varname] == null && ctx["locals"][varname] == null) {
                ctx["locals"][varname] = ctx["nlocal"]
                ctx["nlocal"] = ctx["nlocal"] + 1
            }
            if (indexvar != null && ctx["params"][indexvar] == null && ctx["locals"][indexvar] == null) {
                ctx["locals"][indexvar] = ctx["nlocal"]
                ctx["nlocal"] = ctx["nlocal"] + 1
            }
            if (ctx["locals"][iter_name] == null) {
                ctx["locals"][iter_name] = ctx["nlocal"]
                ctx["nlocal"] = ctx["nlocal"] + 1
            }
            if (ctx["locals"][idx_name] == null) {
                ctx["locals"][idx_name] = ctx["nlocal"]
                ctx["nlocal"] = ctx["nlocal"] + 1
            }
            collect_locals(ctx, s[4])
        }
        i = i + 1
    }
    give ctx
}

fn gen_fn(ctx, s) {
    name = s[1]
    params = s[2]
    body = s[3]
    l = ctx["fns"][name]
    set_label(ctx, l)
    emitc(ctx, [85, 72, 137, 229])
    ctx["params"] = {}
    i = 0
    while (i < size(params)) {
        ctx["params"][params[i]] = i
        i = i + 1
    }
    ctx["locals"] = {}
    ctx["nlocal"] = 0
    ctx["for_count"] = 0
    collect_locals(ctx, body)
    n = ctx["nlocal"]
    if (n > 0) {
        emitc(ctx, [72, 129, 236])
        emitc(ctx, to_le4(n * 8))
    }
    ctx["for_count"] = 0
    gen_stmts(ctx, body)
    ctx["params"] = {}
    ctx["locals"] = {}
    emitc(ctx, [72, 184])
    emitc(ctx, to_le8(1))
    emitc(ctx, [201, 195])
    give ctx
}

fn gen_rt_fn(ctx, name, bytes) {
    l = new_label(ctx)
    ctx["fns"][name] = l
    set_label(ctx, l)
    emitc(ctx, bytes)
    give ctx
}

# Embed the pre-assembled crypto blob (sha256/hmac/hkdf/x25519/aes-gcm) as a
# single position-independent binary. Entry offsets are fixed at build time.
fn emit_crypto(ctx) {
    blob = crypto_blob()
    base = size(ctx["code"])
    emitc(ctx, blob)
    l = new_label(ctx)
    ctx["fns"]["sha256_d"] = l
    ctx["labels"][l] = base + 90
    l = new_label(ctx)
    ctx["fns"]["hmac_d"] = l
    ctx["labels"][l] = base + 143
    l = new_label(ctx)
    ctx["fns"]["hkdf_d"] = l
    ctx["labels"][l] = base + 212
    l = new_label(ctx)
    ctx["fns"]["x25519_d"] = l
    ctx["labels"][l] = base + 287
    l = new_label(ctx)
    ctx["fns"]["gcm_seal_d"] = l
    ctx["labels"][l] = base + 348
    l = new_label(ctx)
    ctx["fns"]["gcm_open_d"] = l
    ctx["labels"][l] = base + 482
    ctx["fix"] = push(ctx["fix"], [base + 2, "call", "__alloc"])
    give ctx
}

fn emit_runtime(ctx) {
    gen_rt_fn(ctx, "__alloc", [85, 72, 137, 229, 83, 72, 139, 69, 16, 72, 131, 192, 7, 72, 131, 224, 248, 72, 187])
    emitc(ctx, zeros(8))
    p = size(ctx["code"]) - 8
    ctx["fix"] = push(ctx["fix"], [p, "heap", 0])
    emitc(ctx, [72, 139, 27, 72, 137, 217, 72, 1, 193, 72, 186])
    emitc(ctx, zeros(8))
    p = size(ctx["code"]) - 8
    ctx["fix"] = push(ctx["fix"], [p, "heap_end", 0])
    emitc(ctx, [72, 139, 18, 72, 57, 209, 119, 19, 72, 184])
    emitc(ctx, zeros(8))
    p = size(ctx["code"]) - 8
    ctx["fix"] = push(ctx["fix"], [p, "heap", 0])
    emitc(ctx, [72, 137, 8, 72, 137, 216, 91, 201, 195, 72, 49, 192, 91, 201, 195])

    gen_rt_fn(ctx, "__str_concat", [85, 72, 137, 229, 72, 139, 93, 16, 72, 131, 235, 1, 72, 139, 115, 8, 72, 139, 93, 24, 72, 131, 235, 1, 72, 139, 75, 8, 72, 137, 242, 72, 1, 202, 72, 131, 194, 17, 82])
    gen_call_runtime(ctx, "__alloc", 1)
    emitc(ctx, [73, 137, 196, 72, 139, 93, 16, 72, 131, 235, 1, 72, 139, 115, 8, 72, 139, 93, 24, 72, 131, 235, 1, 72, 139, 75, 8, 72, 137, 242, 72, 1, 202, 73, 137, 84, 36, 8, 72, 139, 93, 16, 72, 131, 235, 1, 72, 141, 115, 16, 73, 141, 124, 36, 16, 72, 139, 75, 8, 243, 164, 72, 139, 93, 24, 72, 131, 235, 1, 72, 141, 115, 16, 72, 139, 75, 8, 243, 164, 198, 7, 0, 76, 137, 224, 72, 131, 200, 1, 201, 195])

    gen_rt_fn(ctx, "__add", [85, 72, 137, 229, 72, 139, 69, 16, 72, 139, 93, 24, 168, 1, 117, 10, 246, 195, 1, 117, 5, 72, 1, 216, 201, 195, 83, 80])
    gen_call_runtime(ctx, "__str_concat", 2)
    emitc(ctx, [201, 195])

    if (ctx["target"] == "windows") {
