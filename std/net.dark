fn connect(host, port) {
    give tcp_connect(host, port)
}

fn send(s, data) {
    give tcp_send(s, data)
}

fn recv(s, max) {
    give tcp_recv(s, max)
}

fn close(s) {
    tcp_close(s)
    give 0
}

fn serve(port, handler) {
    http_server(port, handler)
    give 0
}

fn http_raw(host, port, request) {
    s = tcp_connect(host, port)
    tcp_send(s, request)
    r = tcp_recv(s, 65536)
    tcp_close(s)
    give r
}

fn get(host, port, path) {
    give http_raw(host, port, "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
}
